# Copy to .env.local for local development. Real values live in Vercel → Project → Settings → Environment Variables.

# Canonical site URL (optional; Vercel's production URL is used when unset).
NEXT_PUBLIC_SITE_URL=

# Mailchimp newsletter (POST /api/subscribe). Server-only — never expose these with NEXT_PUBLIC_.
# API key: Mailchimp → profile avatar → Profile → Extras → API keys → "Create A Key" (looks like abc123…-us21).
MAILCHIMP_API_KEY=
# The data-center suffix after the dash in the API key, e.g. us21.
MAILCHIMP_SERVER_PREFIX=
# Audience → All contacts → Settings → "Audience name and defaults" → Audience ID (e.g. a1b2c3d4e5).
MAILCHIMP_AUDIENCE_ID=
